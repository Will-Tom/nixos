# kitty custom shaders. Template: ~/bin/kitty-glow fills in @STRENGTH@ for the
# current glow level (Super+PageUp / Super+PageDown) and drops the glow group
# at level 0.

# Selection as colored glass (shaders/glass-selection.slang). kitty.conf gives
# the selection a sentinel background that this shader finds.
startgroup
    animation_step 0
    shaders glass-selection
endgroup

# GLOW-BEGIN
# Glow around colored text (shaders/color-glow.slang, kitty's bloom that skips
# white and gray). Colored pixels brighter than the threshold bleed their own
# color outward. Static: redraws only when the screen changes.
startgroup
    animation_step 0
    # minimum brightness (linear) that glows; lower = dimmer text glows too
    var float BLOOM_THRESHOLD = 0.15
    # saturation where glow starts / is full; raise to make only vivid colors glow
    var float SAT_LOW = 0.25
    var float SAT_HIGH = 0.6
    # how strong the halo is
    var float BLOOM_STRENGTH = @STRENGTH@
    shaders color-glow
endgroup
# GLOW-END
